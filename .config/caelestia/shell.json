{
    "bar": {
        "clock": {
            "background": true,
            "showDate": true
        },
        "status": {
            "showAudio": true,
            "showBattery": true,
            "showBluetooth": false,
            "showKbLayout": true,
            "showMicrophone": true,
            "showNetwork": true,
            "showWifi": false
        },
        "tray": {
            "background": false,
            "compact": true,
            "recolour": false
        }
    },
    "general": {
        "apps": {
            "explorer": [
                "yazi"
            ],
            "terminal": [
                "kitty"
            ]
        },
        "idle": {
            "lockBeforeSleep": true,
            "timeouts": [
                {
                    "idleAction": "lock",
                    "timeout": 360
                }
            ]
        }
    },
    "launcher": {
        "vimKeybinds": true
    },
    "services": {
        "useFahrenheit": false
    }
}
